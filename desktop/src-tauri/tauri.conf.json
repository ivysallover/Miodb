{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIO",
  "version": "0.1.0",
  "identifier": "app.mio.escritorio",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MIO",
        "url": "/escritorio",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
