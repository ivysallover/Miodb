{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIO",
  "version": "0.1.0",
  "identifier": "app.mio.escritorio",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MIO",
        "url": "/escritorio",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://apis.google.com",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.googleapis.com",
        "frame-src": "https://analitica-dashboar-y-ml.firebaseapp.com https://accounts.google.com https://apis.google.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "MIO",
    "shortDescription": "Tu planilla de ventas, analizada en tu compu.",
    "category": "Business",
    "macOS": {
      "dmg": {
        "background": "dmg/fondo.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 165,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 200
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QUM3NEM2QTIzQjkxOUYKUldTZmtUdWl4blNzZFRjWnpIN0V3UWhVc0FmTFJVU2JFVFFHRVllc1RpR0ZJOFErVHRrOG83eEIK",
      "endpoints": [
        "https://github.com/ivysallover/Miodb/releases/latest/download/latest.json"
      ]
    }
  }
}
