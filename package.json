{
  "name": "mio-immersive-landing",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp dist/index.html dist/200.html",
    "lint": "tsc -b --noEmit",
    "check": "bash scripts/check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "escritorio": "vite build && cargo build --manifest-path desktop/Cargo.toml --release -p mio-desktop --features custom-protocol",
    "instalador": "vite build && cd desktop/src-tauri && TAURI_SIGNING_PRIVATE_KEY=\"$HOME/.tauri/mio-escritorio.key\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD= tauri build"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "firebase": "^12.19.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.1.2",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
