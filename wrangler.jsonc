{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miodb",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Cloudflare publishes branches other than the production one with `wrangler preview`,
  // which refuses to run without this block (it may stay empty).
  "previews": {}
}
