.DS_Store

# User-provided datasets must not be committed accidentally.
*.csv
# Las planillas de prueba del motor son sintéticas (las escriben los generadores de golden/) y las pruebas las necesitan.
!desktop/engine/tests/golden/**/*.csv
# El ejemplo que trae la app (sintético, lo arma desktop/ejemplos/armar_ejemplo.py): va adentro del programa.
!desktop/src-tauri/ejemplos/*.csv

# Runtime upload storage.
uploads/

# Environment variables & secrets
.env
.env.*
!.env.example
!.env.local.example

# Node & Build artifacts
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Antigravity artifacts & cache exclusion (AGENTS.md)
.antigravity/
artifacts/
archive-2/
*.zip
*.tsbuildinfo
*.mov
*.pdf
/MIO*.png
!public/MIO*.png

# Local runner scripts and scratch files
iniciar_*.bat
iniciar_*.ps1
test_*.json
/mio_*.glb
.venv/



# Copias duplicadas que crea Finder/iCloud ("archivo 2.ext"): nunca son fuente
* 2.*

# Rust (app de escritorio)
desktop/target.nosync/
desktop/src-tauri/gen/
desktop/.venv-referencia/
